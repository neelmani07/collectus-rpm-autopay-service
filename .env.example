APP_NAME=rpm-autopay-service
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Teammate AI service — use mock when unset or unreachable
AI_DECISION_URL=http://127.0.0.1:8001/v1/decide
AI_TIMEOUT_SECONDS=5
USE_MOCK_AI=true

DATABASE_PATH=./data/smart_charge.db
